{
  "name": "tools",
  "version": "0.0.0",
  "description": "Tools — small, self-contained browser tools",
  "author": "Peter Hewat",
  "homepage": "https://peterhewat.github.io/Tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterHewat/Tools.git"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=26.0.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-site.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -p . && bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck && bun run format",
    "test": "bun run --filter '*' test",
    "verify": "bun run check && bun run test && bun run build",
    "new-app": "bun scripts/new-app.ts",
    "outdated": "bun outdated -r",
    "update": "bun update -r",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}

{
  "name": "tools",
  "version": "0.0.0",
  "description": "Tools — small, self-contained browser tools",
  "author": "Peter Hewat",
  "homepage": "https://peterhewat.github.io/Tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterHewat/Tools.git"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.0.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-site.ts",
    "lint": "oxlint",
    "format": "bun fmt --check",
    "format:fix": "bun fmt",
    "typecheck": "bun check --no-script && bun run --filter '*' typecheck",
    "check": "bun run format:fix && bun run lint && bun run typecheck && bun run links",
    "test": "bun run --filter '*' test && bun test scripts",
    "test:browser": "bunx playwright test --config scripts/playwright.config.ts",
    "verify": "bun run check && bun run test && bun run build",
    "new-app": "bun scripts/new-app.ts",
    "outdated": "bun outdated -r",
    "update": "bun update -r",
    "prepare": "git config core.hooksPath .githooks",
    "links": "bun scripts/docs-links.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.65.0",
    "@tools/ui": "workspace:*",
    "@types/bun": "^1.4.4",
    "@zxing/library": "0.23.0",
    "jsqr": "1.4.0",
    "oxlint": "^1.93.0",
    "vite": "^8.3.8"
  }
}
